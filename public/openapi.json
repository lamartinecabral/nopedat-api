{
  "openapi": "3.1.0",
  "info": {
    "title": "Nopedat API",
    "version": "1.0.0",
    "description": "Netlify Edge Function API for the <a href=\"https://nopedat.web.app/\">Nopedat web app</a>, used for reading and updating notes plus authentication flows."
  },
  "paths": {
    "/auth/signup": {
      "post": {
        "summary": "Create account with email and password",
        "description": "Creates a Firebase Auth account and triggers a verification email for the new user before returning the auth token payload.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthEmailPasswordRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Firebase sign-up response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FirebaseAuthSuccess"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body or JSON payload."
          },
          "403": {
            "description": "Forbidden by upstream auth policy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FirebaseAuthError"
                }
              }
            }
          },
          "500": {
            "description": "Missing configuration or internal error."
          }
        }
      },
      "options": {
        "summary": "CORS preflight",
        "responses": {
          "200": {
            "description": "CORS preflight response."
          }
        }
      }
    },
    "/auth/signin": {
      "post": {
        "summary": "Sign in with email and password",
        "description": "Signs in with Firebase email/password auth, then rejects the session unless the account email is already verified.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthEmailPasswordRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Firebase sign-in response for a verified account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FirebaseSignInSuccess"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body or JSON payload."
          },
          "403": {
            "description": "Email is not verified.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "email not verified"
                }
              }
            }
          },
          "500": {
            "description": "Missing configuration or internal error."
          }
        }
      },
      "options": {
        "summary": "CORS preflight",
        "responses": {
          "200": {
            "description": "CORS preflight response."
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Exchange a refresh token for new Firebase tokens",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Firebase token refresh response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FirebaseRefreshSuccess"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body, JSON payload, or missing refresh token."
          },
          "500": {
            "description": "Missing configuration or internal error."
          }
        }
      },
      "options": {
        "summary": "CORS preflight",
        "responses": {
          "200": {
            "description": "CORS preflight response."
          }
        }
      }
    },
    "/auth/password": {
      "post": {
        "summary": "Sign in or sign up with docId and password",
        "description": "Builds a synthetic email as `{docId}@notepade.web.app`, then signs in. If the account does not exist, it creates one with the same credentials.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthDocPasswordRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Firebase auth response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FirebaseAuthSuccess"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body or JSON payload."
          },
          "500": {
            "description": "Missing configuration or internal error."
          }
        }
      },
      "options": {
        "summary": "CORS preflight",
        "responses": {
          "200": {
            "description": "CORS preflight response."
          }
        }
      }
    },
    "/auth/update": {
      "post": {
        "summary": "Update a user's password",
        "description": "Changes the authenticated user's password either by re-authenticating with `email`/`id` and `oldPassword` or by providing a valid Firebase ID token in `validToken`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthUpdatePasswordRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Firebase password update response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FirebaseAuthSuccess"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body, JSON payload, or missing required password update fields."
          },
          "500": {
            "description": "Missing configuration or internal error."
          }
        }
      },
      "options": {
        "summary": "CORS preflight",
        "responses": {
          "200": {
            "description": "CORS preflight response."
          }
        }
      }
    },
    "/doc/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Document id.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "summary": "Get note content",
        "description": "Returns text content for a document by id.",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": false,
            "description": "Bearer token forwarded to Firestore.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful read.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Method not allowed by this function.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Upstream or internal error.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Update note fields",
        "description": "Updates one field on a Firestore document using the raw text request body.",
        "parameters": [
          {
            "name": "field",
            "in": "query",
            "required": false,
            "description": "Field to update. Defaults to `text`. For `protected` or `public`, the raw request body must be `true` or `false`.",
            "schema": {
              "type": "string",
              "enum": ["text", "protected", "public"],
              "default": "text"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "required": false,
            "description": "Bearer token forwarded to Firestore. Required for `field=protected`.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "text/plain": {
              "schema": {
                "type": "string"
              },
              "examples": {
                "text": {
                  "summary": "Document text",
                  "value": "hello world"
                },
                "protected": {
                  "summary": "For `field=protected`, `true` stores the authenticated user's UID and `false` removes protection. The Authorization header is required.",
                  "value": "true"
                },
                "public": {
                  "summary": "For `field=public`, `true` makes the document public and `false` makes it private.",
                  "value": "true"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Update accepted.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "ok"
                }
              }
            }
          },
          "400": {
            "description": "For `field=protected` or `field=public`, the request body must be `true` or `false`.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Protected updates require a valid Bearer token.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Method not allowed by this function.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Upstream or internal error.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "options": {
        "summary": "CORS preflight",
        "responses": {
          "200": {
            "description": "CORS preflight response.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "ok"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthEmailPasswordRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "AuthDocPasswordRequest": {
        "type": "object",
        "required": ["id", "password"],
        "properties": {
          "id": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "AuthUpdatePasswordRequest": {
        "oneOf": [
          {
            "type": "object",
            "required": ["email", "oldPassword", "newPassword"],
            "properties": {
              "email": {
                "type": "string",
                "format": "email"
              },
              "oldPassword": {
                "type": "string"
              },
              "newPassword": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": ["id", "oldPassword", "newPassword"],
            "properties": {
              "id": {
                "type": "string"
              },
              "oldPassword": {
                "type": "string"
              },
              "newPassword": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": ["validToken", "newPassword"],
            "properties": {
              "validToken": {
                "type": "string",
                "description": "A valid Firebase ID token for the user whose password should be changed."
              },
              "newPassword": {
                "type": "string"
              }
            }
          }
        ]
      },
      "RefreshTokenRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Camel-case alias accepted by this endpoint."
          },
          "refresh_token": {
            "type": "string",
            "description": "Firebase-compatible snake-case alias accepted by this endpoint."
          }
        },
        "anyOf": [
          {
            "required": ["refreshToken"]
          },
          {
            "required": ["refresh_token"]
          }
        ]
      },
      "FirebaseAuthSuccess": {
        "type": "object",
        "required": [
          "idToken",
          "email",
          "refreshToken",
          "expiresIn",
          "localId"
        ],
        "properties": {
          "idToken": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "refreshToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "string",
            "description": "Token lifetime in seconds."
          },
          "localId": {
            "type": "string"
          },
          "registered": {
            "type": "boolean",
            "description": "Present on Firebase sign-in responses."
          }
        }
      },
      "FirebaseSignInSuccess": {
        "allOf": [
          {
            "$ref": "#/components/schemas/FirebaseAuthSuccess"
          },
          {
            "type": "object",
            "required": ["registered"],
            "properties": {
              "registered": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "FirebaseRefreshSuccess": {
        "type": "object",
        "required": [
          "expires_in",
          "token_type",
          "refresh_token",
          "id_token",
          "user_id",
          "project_id"
        ],
        "properties": {
          "expires_in": {
            "type": "string",
            "description": "Token lifetime in seconds."
          },
          "token_type": {
            "type": "string",
            "example": "Bearer"
          },
          "refresh_token": {
            "type": "string"
          },
          "id_token": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "project_id": {
            "type": "string"
          }
        }
      },
      "FirebaseAuthError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
